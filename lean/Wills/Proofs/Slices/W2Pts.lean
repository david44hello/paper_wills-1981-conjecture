   [2, 2, 0, 1, 1], [2, 2, 0, 2, 1], [2, 2, 1, 0, 1], [2, 2, 1, 1, 1], [2, 2, 1, 2, 1], [2, 2, 2, 0, 1],
   [2, 2, 2, 0, 2], [2, 2, 2, 1, 1], [2, 2, 2, 2, 1]]

/-- The 117 lattice points of `W`, in box order. -/
def wPts1 : List (List ℤ) := wPts1N.map fun p => p.map fun a => (a : ℤ) - 1

set_option maxRecDepth 100000 in
lemma insideL1_eq_wPts1 : insideL 1 = wPts1 := by decide +kernel

end Wills.Count
